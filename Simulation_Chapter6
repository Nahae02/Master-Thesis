logExcessAtN <- function(delta, ya, yb, na, nb, cumYa, cumYb,
                         priorA1, priorA2, priorB1, priorB2, n, alpha) {
  currentE <- 1
  breveThetaA <- priorA1 / (priorA1 + priorA2)
  breveThetaB <- priorB1 / (priorB1 + priorB2)
  thetaARIPr <- safestats:::tryOrFailWithNA(stats::uniroot(safestats:::calculateDerivativeKLTwoProportionsLinear, interval = c(max(c(0, -delta)) + 0.001, min(c(1, 1 - delta)) - 0.001),
    delta = delta, na = na, nb = nb, breveThetaA = breveThetaA, breveThetaB = breveThetaB)$root)
  
  for (i in seq_len(n)) {
    if (!is.na(thetaARIPr)) {
      likAlt <- safestats:::likelihoodTwoProportions(na1 = ya[i], na = na, nb1 = yb[i], nb = nb, thetaA = breveThetaA, thetaB = breveThetaB)
      likRIPr <- safestats:::likelihoodTwoProportions(na1 = ya[i], na = na, nb1 = yb[i], nb = nb, thetaA = thetaARIPr, thetaB = thetaARIPr + delta)
      currentE <- currentE * likAlt / likRIPr
    }
    if (currentE >= 1 / alpha) return(log(currentE) - log(1 / alpha))
    
    breveThetaA <- (cumYa[i] + priorA1) / (i * na + priorA1 + priorA2)
    breveThetaB <- (cumYb[i] + priorB1) / (i * nb + priorB1 + priorB2)
    thetaARIPr <- safestats:::tryOrFailWithNA(stats::uniroot(safestats:::calculateDerivativeKLTwoProportionsLinear, interval = c(max(c(0, -delta)) + 0.001, min(c(1, 1 - delta)) - 0.001),
      delta = delta, na = na, nb = nb, breveThetaA = breveThetaA, breveThetaB = breveThetaB)$root)
  }
  log(currentE) - log(1 / alpha)
}

findCSBoundary <- function(side, lo, hi, ya, yb, na, nb, cumYa, cumYb, priorA1, priorA2, priorB1, priorB2, n, alpha, tol = 1e-6) {
  f <- function(delta) logExcessAtN(delta, ya, yb, na, nb, cumYa, cumYb, priorA1, priorA2, priorB1, priorB2, n, alpha)
  fLo <- f(lo)
  fHi <- f(hi)
  if (is.na(fLo) || is.na(fHi) || sign(fLo) == sign(fHi)) {
    return(if (side == "lower") lo else hi)
  }
  stats::uniroot(f, lower = lo, upper = hi, tol = tol)$root
}

computeCSWidthRootfind <- function(ya, yb, na, nb, hyper_ref,
                                   checkpoints, alpha = 0.05, tol = 1e-6) {
  checkpoints <- sort(checkpoints)
  cumYa <- cumsum(ya); cumYb <- cumsum(yb)
  priorA1 <- hyper_ref[["betaA1"]]; priorA2 <- hyper_ref[["betaA2"]]
  priorB1 <- hyper_Ref[["betaB1"]]; priorB2 <- hyper_ref[["betaB2"]]
  
  lowerBound <- numeric(length(checkpoints)); upperBound <- numeric(length(checkpoints))
  prevLo <- -0.99; prevHi <- 0.99
  
  for (k in seq_along(checkpoints)) {
    n <- checkpoints[k]
    thetaAHat <- cumYa[n] / (n * na); thetaBHat <- cumYb[n] / (n * nb)
    deltaHat <- max(min(thetaBHat - thetaAHat, 0.98), -0.98)
    
    lo <- findCSBoundary("lower", prevLo, deltaHat, ya, yb, na, nb, cumYa, cumYb, priorA1, priorA2, priorB1, priorB2, n, alpha, tol)
    hi <- findCSBoundary("upper", deltaHat, prevHi, ya, yb, na, nb, cumYa, cumYb, priorA1, priorA2, priorB1, priorB2, n, alpha, tol)
    lowerBound[k] <- lo
    upperBound[k] <- hi
    prevLo <- lo
    prevHi <- hi
  }
  data.frame(n = checkpoints, lower = lowerBound, upper = upperBound, width = upperBound - lowerBound)
}

classicalCIWidthAtCheckpoints <- function(ya, yb, na, nb, checkpoints, alpha = 0.05) {
  cumYa <- cumsum(ya); cumYb <- cumsum(yb)
  z <- qnorm(1 - alpha / 2)
  sapply(checkpoints, function(n) {
    nAtot <- n * na; nBtot <- n * nb
    thetaAHat <- cumYa[n] / nAtot; thetaBHat <- cumYb[n] / nBtot
    se <- sqrt(thetaAHat * (1 - thetaAHat) / nAtot + thetaBHat * (1 - thetaBHat) / nBtot)
    2 * z * se
  })
}

## ---- One replicate: simulate, compute both widths, checkpoint to disk ----

runOneReplicate <- function(m) {
  repFile <- file.path(outDir, sprintf("rep_%02d.rds", m))
  if (file.exists(repFile)) {
    cat("Replicate", m, "already done, loading from disk\n")
    return(readRDS(repFile))
  }
  
  set.seed(1000 + m)  # distinct, reproducible seed per replicate
  nMax <- max(checkpoints)
  ya <- rbinom(nMax, na, theta_a)
  yb <- rbinom(nMax, nb, theta_b)
  
  t0 <- Sys.time()
  csRes <- computeCSWidthRootfind(ya, yb, na, nb, hyper_ref, checkpoints, alpha, tol)
  ciWidths <- classicalCIWidthAtCheckpoints(ya, yb, na, nb, checkpoints, alpha)
  elapsed <- as.numeric(Sys.time() - t0, units = "secs")
  cat("Replicate", m, "done in", round(elapsed, 1), "s\n")
  
  result <- rbind(
    data.frame(rep = m, n = checkpoints, width = csRes$width, method = "AV confidence sequence"),
    data.frame(rep = m, n = checkpoints, width = ciWidths, method = "Classical CI (prop.test)")
  )
  saveRDS(result, repFile)
  result
}

