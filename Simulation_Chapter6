log_seq <- function(from, to, length.out) {
  unique(round(exp(seq(log(from), log(to), length.out = length.out))))
}

design_cs <- designSafeTwoProportions(na = 1, nb = 1, alpha = alpha, nBlocksPlan = N_max, pilot = TRUE, hyperParameterValues = hyper_ref)
## design built WITHOUT delta/alternativeRestriction (defaults to "none"):
## the CS functions sweep delta internally via deltaStart/deltaStop/precision,
## so the design itself should stay unrestricted. Worth a quick sanity check
## once you can run this against the real package.

calculateEValuesForLinearDeltaGridFast <- function(ya, yb, na, nb, hyper_ref,
                                                    precision = 10, alpha = 0.05,
                                                    runningIntersection = TRUE) {
  deltaVec <- seq(-0.99, 0.99, length.out = precision)
  cumYa <- cumsum(ya)
  cumYb <- cumsum(yb)
  priorA1 <- hyper_ref[["betaA1"]]; priorA2 <- hyper_ref[["betaA2"]]
  priorB1 <- hyper_ref[["betaB1"]]; priorB2 <- hyper_ref[["betaB2"]]
  ciEValues <- data.frame()
  for (delta in deltaVec) {
    currentE <- 1
    breveThetaA <- priorA1 / (priorA1 + priorA2)
    breveThetaB <- priorB1 / (priorB1 + priorB2)
    thetaARIPr <- safestats:::tryOrFailWithNA(stats::uniroot(
      safestats:::calculateDerivativeKLTwoProportionsLinear,
      interval = c(max(c(0, -delta)) + 0.001, min(c(1, 1 - delta)) - 0.001),
      delta = delta, na = na, nb = nb, breveThetaA = breveThetaA, breveThetaB = breveThetaB)$root)
    
    for (i in seq_along(ya)) {
      if (!is.na(thetaARIPr)) {
        likelihoodAlternative <- safestats:::likelihoodTwoProportions(
          na1 = ya[i], na = na, nb1 = yb[i], nb = nb, thetaA = breveThetaA, thetaB = breveThetaB)
        likelihoodRIPr <- safestats:::likelihoodTwoProportions(
          na1 = ya[i], na = na, nb1 = yb[i], nb = nb, thetaA = thetaARIPr, thetaB = thetaARIPr + delta)
        currentE <- currentE * likelihoodAlternative / likelihoodRIPr
      }
      if ((currentE >= 1 / alpha) & runningIntersection) {
        break
      }
      ## inlined posterior-mean formula, no function call, O(1) via cumsum lookup
      breveThetaA <- (cumYa[i] + priorA1) / (i * na + priorA1 + priorA2)
      breveThetaB <- (cumYb[i] + priorB1) / (i * nb + priorB1 + priorB2)
      thetaARIPr <- safestats:::tryOrFailWithNA(stats::uniroot(
        safestats:::calculateDerivativeKLTwoProportionsLinear,
        interval = c(max(c(0, -delta)) + 0.001, min(c(1, 1 - delta)) - 0.001),
        delta = delta, na = na, nb = nb, breveThetaA = breveThetaA, breveThetaB = breveThetaB)$root)
    }
    ciEValues <- rbind(ciEValues, data.frame(delta = delta, E = currentE))
  }
  return(ciEValues)
}

computeConfidenceBoundsForDifferenceTwoProportionsFast <- function(ya, yb, precision, safeDesign) {
  na <- safeDesign[["nPlan"]][["na"]]
  nb <- safeDesign[["nPlan"]][["nb"]]
  alpha <- safeDesign[["alpha"]]
  eValuesDeltaGrid <- calculateEValuesForLinearDeltaGridFast(
    ya = ya, yb = yb, na = na, nb = nb,
    hyper_ref = safeDesign[["betaPriorParameterValues"]],
    precision = precision, alpha = alpha, runningIntersection = TRUE)
  ciSummary <- eValuesDeltaGrid %>% dplyr::filter(.data[["E"]] < 
    1 / alpha) %>% dplyr::summarise(lowerBound = min(.data[["delta"]]), 
    upperBound = max(.data[["delta"]]))
  return(as.list(ciSummary))
}

