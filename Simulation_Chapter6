## CS: n_CS(thetaA_star) from the validated asymptotic formula 

rho <- function(n) sqrt(2 * log(1 / alpha) + log(n)) / z_alpha

solveNForTargetWidth <- function(thetaA_star, thetaB_star, w, nMaxSearch = 1e9) {
  Vstar <- thetaA_star * (1 - thetaA_star) + thetaB_star * (1 - thetaB_star)
  f <- function(n) rho(n) * 2 * z_alpha * sqrt(Vstar / n) - w
  uniroot(f, interval = c(100, nMaxSearch))$root
}

nCS <- sapply(thetaAStarGrid, function(ta) {
  tb <- ta + delta0
  solveNForTargetWidth(ta, tb, wTarget)
})
names(nCS) <- thetaAStarGrid
cat("n_CS per theta_A*:\n")
