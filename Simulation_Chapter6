## Classical CI: simulate realized width at n_planned, per true theta_A* 

simulateRealizedWidth <- function(thetaA_star, thetaB_star, n, M) {
  succA <- rbinom(M, size = n, prob = thetaA_star)
  succB <- rbinom(M, size = n, prob = thetaB_star)
  thetaAHat <- succA / n
  thetaBHat <- succB / n
  se <- sqrt(thetaAHat * (1 - thetaAHat) / n + thetaBHat * (1 - thetaBHat) / n)
  width <- 2 * z_alpha * se
  diff <- thetaBHat - thetaAHat
  lo <- diff - z_alpha * se
  hi <- diff + z_alpha * se
  covers_delta0 <- (lo <= delta0) & (hi >= delta0)
  data.frame(width = width, covers_delta0 = covers_delta0)
}

dfClassical <- do.call(rbind, lapply(thetaAStarGrid, function(ta) {
  tb <- ta + delta0
  res <- simulateRealizedWidth(ta, tb, nPlanned, M)
  data.frame(
    thetaA_star = ta,
    mean_width = mean(res$width),
    se_width = sd(res$width) / sqrt(M),
    coverage = mean(res$covers_delta0)
  )
}))
cat("\nKlassischer CI -- realisierte Breite & Coverage von delta0, pro theta_A*:\n")
print(dfClassical)

