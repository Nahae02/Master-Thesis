## Same budget comparison
###############################################################################

M_budget          <- 100      # reduce for benchmarking, see below
look_every_budget <- 5000

seq_power_at_budget <- function(restriction, delta) {
  theta_b <- theta_a + delta
  design <- NULL
  hyper <- list(betaA1 = priorA1, betaA2 = priorA2, betaB1 = priorB1, betaB2 = priorB2)
  if (restriction == "difference") {
    design <- designSafeTwoProportions(na=1, nb=1, alpha=alpha, delta=delta0, beta=0.2,
                                       alternativeRestriction="difference", hyperParameterValues=hyper)
  } else if (restriction == "logOddsRatio") {
    theta_b_design <- theta_a + delta0
    lor <- log(theta_b_design/(1-theta_b_design) * (1-theta_a)/theta_a)
    design <- designSafeTwoProportions(na=1, nb=1, alpha=alpha, delta=lor, beta=0.2,
                                       alternativeRestriction="logOddsRatio", hyperParameterValues=hyper)
  }
  res <- do.call(rbind, parallel::mclapply(1:M_budget, function(i) {
    ya <- rbinom(n_fisher_misspec, 1, theta_a); yb <- rbinom(n_fisher_misspec, 1, theta_b)
    if (restriction == "none") {
      firstcross_2prop(ya, yb, priorA1, priorA2, priorB1, priorB2, look_every = look_every_budget)
    } else {
      firstcross_pkg(ya, yb, design, look_every = look_every_budget)
    }
  }, mc.cores = mc.cores, mc.preschedule = FALSE))
  mean(res[, "reject"])
}

grid_budget <- expand.grid(restriction = restrictions, delta = deltas_misspec_extended, stringsAsFactors = FALSE)
grid_budget$power <- mapply(seq_power_at_budget, grid_budget$restriction, grid_budget$delta)

df_budget_compare <- rbind(
  data.frame(delta = deltas_misspec_extended, power = fisher_misspec_power,
             method = "Fisher (fixed n, misspecified)"),
  transform(grid_budget, method = paste0("E-value (", lbl[restriction], "), same budget"))[, c("delta","power","method")]
)

