## ---- unrestricted e-value stopper ----
firstcross_2prop <- function(ya, yb, betaA1, betaA2, betaB1, betaB2,
                             thr = 1/alpha, look_every = 1) {
  N <- length(ya)
  Ua_lag <- c(0, cumsum(ya)[-N])
  Ub_lag <- c(0, cumsum(yb)[-N])
  j <- seq_len(N)
  ta <- (Ua_lag + betaA1) / ((j - 1) + betaA1 + betaA2)
  tb <- (Ub_lag + betaB1) / ((j - 1) + betaB1 + betaB2)
  t0 <- 0.5 * (ta + tb)
  inc <- (ya*log(ta) + (1-ya)*log(1-ta) - ya*log(t0) - (1-ya)*log(1-t0)) +
    (yb*log(tb) + (1-yb)*log(1-tb) - yb*log(t0) - (1-yb)*log(1-t0))
  logE <- cumsum(inc)
  checkpoints <- seq(look_every, N, by = look_every)
  lb <- log(thr)
  hit <- checkpoints[which(logE[checkpoints] >= lb)[1]]
  if (!is.na(hit)) c(reject = 1, stop = hit) else c(reject = 0, stop = N)
}

firstcross_pkg <- function(ya, yb, design, thr = 1/alpha, look_every) {
  N <- length(ya)
  for (t in seq(look_every, N, by = look_every)) {
    if (safe.prop.test(ya[1:t], yb[1:t], designObj = design)$eValue >= thr)
      return(c(reject = 1, stop = t))
  }
  c(reject = 0, stop = N)
}

stream_stopper <- function(theta_a, theta_b, restriction, N_max, design = NULL, look_every) {
  ya <- rbinom(N_max, 1, theta_a); yb <- rbinom(N_max, 1, theta_b)
  if (restriction == "none")
    firstcross_2prop(ya, yb, priorA1, priorA2, priorB1, priorB2, look_every = look_every)
  else
    firstcross_pkg(ya, yb, design, look_every = look_every)
}

## ---- N_max and look_every scale to each delta's own classical requirement ----
#margin_factor <- 2     
n_checkpoints <- 110   # matches the original 2,200,000 / 20,000 resolution

sample_size_by_restriction <- function(theta_a, delta, restriction, alpha = 0.05) {
  theta_b <- theta_a + delta
  
  n_np_d       <- ceiling(power.prop.test(p1 = theta_a, p2 = theta_b,
                                          power = 0.8, sig.level = alpha)$n)
  margin_d <- if (restriction == "none") 5 else 2
  N_max_d      <- ceiling(margin_d * n_np_d)
  look_every_d <- max(1, ceiling(N_max_d / n_checkpoints))
  
  design <- NULL
  hyper <- list(betaA1 = priorA1, betaA2 = priorA2, betaB1 = priorB1, betaB2 = priorB2)
  if (restriction == "difference") {
    design <- designSafeTwoProportions(na=1, nb=1, alpha=alpha, delta=delta0, beta=0.2,
                                       alternativeRestriction="difference", hyperParameterValues=hyper)
  } else if (restriction == "logOddsRatio") {
    theta_b_design <- theta_a + delta0
    lor <- log(theta_b_design/(1-theta_b_design) * (1-theta_a)/theta_a)
    design <- designSafeTwoProportions(na=1, nb=1, alpha=alpha, delta=lor, beta=0.2,
                                       alternativeRestriction="logOddsRatio", hyperParameterValues=hyper)
  }
  res <- t(do.call(cbind, parallel::mclapply(1:M, function(i)
    stream_stopper(theta_a, theta_b, restriction, N_max_d, design, look_every_d),
    mc.cores = mc.cores, mc.preschedule = FALSE)))
  tau <- res[, "stop"]; power <- mean(res[, "reject"])
  if (power < 0.8) return(c(worst = NA, exp = NA, power = power))
  m_planned  <- as.numeric(quantile(tau, 0.8, type = 1))
  m_expected <- mean(pmin(tau, m_planned))
  c(worst = m_planned, exp = m_expected, power = power)
}

