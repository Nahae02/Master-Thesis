## planned once at delta0
n_fisher_misspec <- ceiling(power.prop.test(p1 = theta_a, p2 = theta_a + delta0,
                                            power = 0.8, sig.level = alpha)$n)

deltas_misspec_extended <- c(0.0005, 0.001, 0.0015, deltas)  # below and at/above delta0

fisher_misspec_power <- sapply(deltas_misspec_extended, function(d)
  mean(replicate(M, {
    a <- rbinom(1, n_fisher_misspec, theta_a); b <- rbinom(1, n_fisher_misspec, theta_a + d)
    fisher.test(matrix(c(a, n_fisher_misspec-a, b, n_fisher_misspec-b), 2))$p.value <= alpha
  })))

fisher_oracle_df <- do.call(rbind, lapply(restrictions, function(r)
  data.frame(delta = deltas, n = fisher_oracle, restriction = r, setting = "P-value (Fisher, oracle delta)")))

