fisher_n_simulated <- function(theta_a, theta_b, target_power = 0.8, alpha = 0.05,
                               M = 1000, n_start = NULL, step = NULL) {
  if (is.null(n_start))
    n_start <- ceiling(power.prop.test(p1=theta_a, p2=theta_b, power=target_power, sig.level=alpha)$n)
  if (is.null(step)) step <- max(1, round(n_start * 0.1))   # climb in ~10% increments
  
  n <- n_start
  repeat {
    power_est <- mean(replicate(M, {
      a <- rbinom(1, n, theta_a); b <- rbinom(1, n, theta_b)
      fisher.test(matrix(c(a, n-a, b, n-b), 2))$p.value <= alpha
    }))
    if (power_est >= target_power) break
    n <- n + step
  }
  c(n = n, power = power_est)
}

