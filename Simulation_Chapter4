firstcross_pkg <- function(ya, yb, design, thr = 1/alpha, look_every) {
  N <- length(ya)
  for (t in seq(look_every, N, by = look_every)) {
    if (safe.prop.test(ya[1:t], yb[1:t], designObj = design)$eValue >= thr)
      return(c(reject = 1, stop = t))
  }
  c(reject = 0, stop = N)
}

stream_stopper <- function(theta_a, theta_b, gamma, restriction, N_max, design = NULL) {
  ya <- rbinom(N_max, 1, theta_a); yb <- rbinom(N_max, 1, theta_b)
  if (restriction == "none") firstcross_2prop(ya, yb, gamma)
  else                       firstcross_pkg(ya, yb, design, look_every = 10) #before: look_every = 40 to bring down computation time
}

sample_size_by_restriction_ci <- function(theta_a, delta, gamma, restriction,
                                          N_max = 8000, M = 1000, alpha = 0.05, B = 1000) {
  design_delta <- 0.04 
  theta_b <- theta_a + delta
  design <- NULL
  hyper <- list(betaA1 = gamma, betaA2 = gamma, betaB1 = gamma, betaB2 = gamma)
  if (restriction == "difference") {
    design <- designSafeTwoProportions(na=1, nb=1, alpha=alpha, delta=design_delta, beta=0.2,
                                       alternativeRestriction="difference", hyperParameterValues=hyper)
  } else if (restriction == "logOddsRatio") {
    theta_b_design <- theta_a + design_delta
    lor <- log(theta_b_design/(1-theta_b_design) * (1-theta_a)/theta_a)
    design <- designSafeTwoProportions(na=1, nb=1, alpha=alpha, delta=lor, beta=0.2,
                                       alternativeRestriction="logOddsRatio", hyperParameterValues=hyper)
  }
  res <- t(replicate(M, stream_stopper(theta_a, theta_b, gamma, restriction, N_max, design)))
  tau <- res[, "stop"]; power <- mean(res[, "reject"])
  if (power < 0.8) return(c(worst=NA, worst_lo=NA, worst_hi=NA, exp=NA, exp_lo=NA, exp_hi=NA, power=power))
  
  m_planned <- as.numeric(quantile(tau, 0.8, type = 1))
  ex_draws  <- pmin(tau, m_planned)
  
  ## bootstrap: resample the M draws with replacement, B times, recompute both statistics
  boot <- replicate(B, {
    s <- sample(tau, M, replace = TRUE)
    q <- as.numeric(quantile(s, 0.8, type = 1))
    e <- mean(pmin(s, q))
    c(worst = q, exp = e)
  })
  
  c(worst    = m_planned,
    worst_lo = unname(quantile(boot["worst",],.025)), 
    worst_hi = unname(quantile(boot["worst",],.975)),
    exp      = mean(ex_draws),
    exp_lo   = unname(quantile(boot["exp",],.025)),
    exp_hi   = unname(quantile(boot["exp",],.975)),
    power = power)
}

