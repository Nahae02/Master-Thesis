alpha <- 0.05
gamma <- 0.18

## --- not used ---
evalue_2prop <- function(ya, yb, gamma) {
  m <- length(ya)
  logE <- 0
  E <- numeric(m)
  Ua <- 0; Ub <- 0
  for (j in 1:m) {
    ta <- (Ua + gamma) / ((j - 1) + 2 * gamma)     # posterior-mean rate, group a (data thru j-1)
    tb <- (Ub + gamma) / ((j - 1) + 2 * gamma)     # posterior-mean rate, group b
    t0 <- 0.5 * (ta + tb)                          # pooled null rate (n_a = n_b = 1)
    a <- ya[j]; b <- yb[j]
    logE <- logE +
      (a*log(ta) + (1-a)*log(1-ta) - a*log(t0) - (1-a)*log(1-t0)) +
      (b*log(tb) + (1-b)*log(1-tb) - b*log(t0) - (1-b)*log(1-t0))
    E[j] <- exp(logE)
    Ua <- Ua + a; Ub <- Ub + b
  }
  E
}

firstcross_2prop <- function(ya, yb, gamma, thr = 1/alpha) {
  logE <- 0
  Ua <- 0
  Ub <- 0
  N <- length(ya)
  lb <- log(thr)
  
  for (j in 1:N) {
    ta <- (Ua + gamma)/((j-1) + 2*gamma); tb <- (Ub + gamma)/((j-1) + 2*gamma)
    t0 <- 0.5*(ta + tb); a <- ya[j]; b <- yb[j]
    logE <- logE +
      (a*log(ta)+(1-a)*log(1-ta) - a*log(t0)-(1-a)*log(1-t0)) +
      (b*log(tb)+(1-b)*log(1-tb) - b*log(t0)-(1-b)*log(1-t0))
    if (logE >= lb) return(c(reject = 1, stop = j))
    Ua <- Ua + a; Ub <- Ub + b
  }
  c(reject = 0, stop = N)
}

