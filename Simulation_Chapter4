## Experiment 1: validity under optional stopping  (Fig. S3.1)
## =====================================================================
## e-value  vs.  Fisher's exact test applied repeatedly (peeking)
exp1 <- function(theta0 = 0.5, N = 300, M = 1000, gamma, look_every = 5) {
  e_rej <- e_stop <- f_rej <- f_stop <- numeric(M)
  for (s in 1:M) {
    ya <- rbinom(N, 1, theta0); yb <- rbinom(N, 1, theta0)   # H0: equal rates
    fc <- firstcross_2prop(ya, yb, gamma)
    e_rej[s] <- fc[1]
    e_stop[s] <- fc[2]
    
    looks <- seq(look_every, N, by = look_every)
    sig <- 0
    st <- N
    for (n in looks) {                                       # peeking Fisher
      sa <- sum(ya[1:n])
      sb <- sum(yb[1:n])
      if (fisher.test(matrix(c(sa, n-sa, sb, n-sb), 2, byrow = TRUE))$p.value <= alpha) {
        sig <- 1; st <- n; break }
    }
    f_rej[s] <- sig
    f_stop[s] <- st
  }
  list(typeI = c(evalue = mean(e_rej), fisher_peeking = mean(f_rej)),
       e_rej = e_rej, e_stop = e_stop, f_rej = f_rej, f_stop = f_stop, N = N)
}

r1 <- exp1()                     # (Fisher every block is the slow part; ~1–2 min)
print(r1$typeI)                  # expect evalue <= 0.05, fisher_peeking >> 0.05

## cumulative type-I error vs. number of blocks monitored
grid <- seq(look_every <- 5, r1$N, by = 5)
cum  <- function(rej, stop) sapply(grid, function(t) mean(rej == 1 & stop <= t))
df_cum <- rbind(
  data.frame(t = grid, err = cum(r1$e_rej, r1$e_stop), method = "e-value"),
  data.frame(t = grid, err = cum(r1$f_rej, r1$f_stop), method = "peeking Fisher"))
p_cum <- ggplot(df_cum, aes(t, err, colour = method)) +
  geom_line(linewidth = 1) + geom_hline(yintercept = alpha, linetype = "dashed") +
  labs(x = "number of blocks monitored", y = "cumulative type-I error")

print(p_cum)


## =====================================================================
## Experiment 2: smallest "planning" horizon m for 80% power at a FIXED theta_a, and the
## expected sample size actually used at that horizon. (Analogue of paper's Fig. 3(a))
## =====================================================================
sample_size_curve <- function(theta_a, delta, gamma, N_max = 8000, M = 2000) {
  theta_b <- theta_a + delta
  res <- t(replicate(M, firstcross_2prop(rbinom(N_max, 1, theta_a),
                                         rbinom(N_max, 1, theta_b), gamma)))
  tau <- res[, "stop"]; power_at_Nmax <- mean(res[, "reject"])
  if (power_at_Nmax < 0.8) return(c(m_planned = NA, m_expected = NA, power = power_at_Nmax))
  m_planned  <- as.numeric(quantile(tau, 0.8, type = 1))   # horizon covering 80% of runs
  m_expected <- mean(pmin(tau, m_planned))                 # avg. usage at that horizon
  c(m_planned = m_planned, m_expected = m_expected, power = power_at_Nmax)
}

gammas   <- c(0.05, 0.18, 1, 20, 1000)     # 0.18 ~= mildly U-shaped; 1000 ~= peaked at 0.5
theta_as <- c(0.01, 0.1, 0.5)
deltas_exp2   <- seq(0.05, 0.3, by = 0.05)

grid2 <- expand.grid(gamma = gammas, theta_a = theta_as, delta = deltas_exp2)
grid2 <- subset(grid2, theta_a + delta <= 1)

res <- t(apply(grid2, 1, function(r)
  sample_size_curve(theta_a = r["theta_a"], delta = r["delta"], gamma = r["gamma"])))
grid2 <- cbind(grid2, res)

## ---- worst-case (planning horizon) only ----
p_planning <- ggplot(grid2, aes(delta, log(m_planned), colour = factor(gamma))) +
  geom_line() + geom_point(na.rm = TRUE) +
  facet_wrap(~ theta_a, labeller = label_both) +
  labs(x = expression(delta), y = "log(sample size, blocks)",
       colour = expression(gamma), title = "Planning horizon (80% power)")

## ---- expected usage only ----
p_expected <- ggplot(grid2, aes(delta, log(m_expected), colour = factor(gamma))) +
  geom_line() + geom_point(na.rm = TRUE) +
  facet_wrap(~ theta_a, labeller = label_both) +
  labs(x = expression(delta), y = "log(sample size, blocks)",
       colour = expression(gamma), title = "Expected usage")

ggsave("turner_planning.pdf", p_planning, width = 9, height = 6)
